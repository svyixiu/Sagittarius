{
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/builds.js", "destination": "/web/builds.js" },
    { "source": "/codec.js", "destination": "/web/codec.js" },
    { "source": "/primitives.js", "destination": "/web/primitives.js" },
    { "source": "/quotes.js", "destination": "/web/quotes.js" },
    { "source": "/sagittarius.js", "destination": "/web/sagittarius.js" },
    { "source": "/tesseract7.js", "destination": "/web/tesseract7.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'" }
      ]
    }
  ]
}
