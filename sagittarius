#!/usr/bin/env python3
"""Sagittarius local web launcher.

Runs the static Sagittarius UI on a loopback HTTP server and opens it in the
user's default browser. No application data is sent to this launcher; the
cryptography remains inside the browser.
"""

from __future__ import annotations

import argparse
import contextlib
import http.server
import json
import os
from pathlib import Path
import socket
import sys
import threading
import time
import webbrowser

APP_NAME = "Sagittarius"
DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 7376
WEB_ROOT = Path(__file__).resolve().parent / "web"


class SagittariusHandler(http.server.SimpleHTTPRequestHandler):
    server_version = "SagittariusLocal/1.0"

    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(WEB_ROOT), **kwargs)

    def log_message(self, fmt: str, *args) -> None:
        if getattr(self.server, "quiet", False):
            return
        sys.stderr.write("[Sagittarius] " + (fmt % args) + "\n")

    def end_headers(self) -> None:
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Permissions-Policy", "camera=(), microphone=(), geolocation=()")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'self' blob:; "
            "script-src 'self'; "
            "style-src 'self' 'unsafe-inline'; "
            "img-src 'self' data: blob:; "
            "object-src 'none'; base-uri 'none'; form-action 'none'",
        )
        super().end_headers()

    def do_GET(self) -> None:
        if self.path.rstrip("/") == "/__sagittarius__/health":
            payload = json.dumps({"ok": True, "app": APP_NAME}).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return
        super().do_GET()


class SagittariusServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def port_available(host: str, port: int) -> bool:
    with contextlib.closing(socket.socket(socket.AF_INET, socket.SOCK_STREAM)) as sock:
        try:
            sock.bind((host, port))
        except OSError:
            return False
        return True


def choose_port(host: str, requested: int, strict: bool) -> int:
    if port_available(host, requested):
        return requested
    if strict:
        raise OSError(f"Port {requested} is already in use on {host}.")
    for port in range(requested + 1, requested + 101):
        if port_available(host, port):
            return port
    raise OSError(f"No free port found between {requested} and {requested + 100}.")


def open_browser(url: str) -> None:
    time.sleep(0.25)
    with contextlib.suppress(Exception):
        webbrowser.open(url, new=2)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="sagittarius",
        description="Launch the Sagittarius encryption UI locally.",
    )
    parser.add_argument("--host", default=DEFAULT_HOST, help=f"Bind host (default: {DEFAULT_HOST})")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help=f"Preferred port (default: {DEFAULT_PORT})")
    parser.add_argument("--strict-port", action="store_true", help="Fail instead of selecting the next free port")
    parser.add_argument("--no-open", action="store_true", help="Do not open the browser automatically")
    parser.add_argument("--quiet", action="store_true", help="Hide HTTP request logs")
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if not WEB_ROOT.is_dir() or not (WEB_ROOT / "index.html").is_file():
        print(f"[Sagittarius] Web UI not found at {WEB_ROOT}", file=sys.stderr)
        return 2

    if not (1 <= args.port <= 65535):
        print("[Sagittarius] --port must be between 1 and 65535.", file=sys.stderr)
        return 2

    try:
        port = choose_port(args.host, args.port, args.strict_port)
        server = SagittariusServer((args.host, port), SagittariusHandler)
        server.quiet = args.quiet
    except OSError as exc:
        print(f"[Sagittarius] Could not start local server: {exc}", file=sys.stderr)
        return 1

    display_host = "127.0.0.1" if args.host in {"0.0.0.0", "::"} else args.host
    url = f"http://{display_host}:{port}/"

    print()
    print("  Sagittarius Local")
    print("  -----------------")
    print(f"  UI:     {url}")
    print(f"  Root:   {WEB_ROOT}")
    print("  Scope:  local browser session")
    if port != args.port:
        print(f"  Note:   port {args.port} was busy; using {port}")
    print()
    print("  Press Ctrl+C to stop.")
    print()

    if not args.no_open:
        threading.Thread(target=open_browser, args=(url,), daemon=True).start()

    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        print("\n[Sagittarius] Stopping.")
    finally:
        server.server_close()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
